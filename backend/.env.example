# Required. Read at request time, never logged.
ANTHROPIC_API_KEY=

# Model used by every route. Defaults to claude-sonnet-4-6 if unset.
ANTHROPIC_MODEL=claude-sonnet-4-6

# Comma-separated list of allowed origins for CORS.
# Add your deployed Next.js origin here in production.
CORS_ORIGINS=http://localhost:3000

# Per-IP rate limit applied to every AI route.
RATE_LIMIT_PER_MINUTE=30

# Bind address for uvicorn when running via `python -m app`.
HOST=0.0.0.0
PORT=8000
