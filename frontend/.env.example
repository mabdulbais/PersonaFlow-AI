# Server-only. Never expose to the browser.
ANTHROPIC_API_KEY=

# Model used by the API routes. Defaults to claude-sonnet-4-6 if unset.
ANTHROPIC_MODEL=claude-sonnet-4-6

# Optional: when the FastAPI backend exists, point the Next.js API routes
# at it instead of calling Anthropic directly. Leave unset to call Anthropic
# from the Next.js server.
# FASTAPI_BASE_URL=http://localhost:8000
